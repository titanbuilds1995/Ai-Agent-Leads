# systemd unit for the Twilio inbound webhook. Installed by deploy/bootstrap_vps.sh (which fills in TITAN_DIR/TITAN_USER).
# Binds to localhost only; nginx (deploy/nginx-titan.conf) terminates TLS in front of it.
[Unit]
Description=Titan lead engine - Twilio webhook (FastAPI/uvicorn)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__TITAN_USER__
WorkingDirectory=__TITAN_DIR__
ExecStart=__TITAN_DIR__/.venv/bin/python -m titan.cli webhook --host 127.0.0.1 --port 8080
Restart=always
RestartSec=5
# hardening: the service only needs to read the repo + .env/secrets and write the db, logs and reports
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=__TITAN_DIR__

[Install]
WantedBy=multi-user.target
