# Copy to .env and fill in. Never commit .env.
APIFY_TOKEN=
ANTHROPIC_API_KEY=
# Path to the OAuth client JSON downloaded from Google Cloud Console (Gmail API, Desktop app type)
GMAIL_OAUTH_JSON=secrets/gmail_oauth_client.json
# Where the authorized user token is stored after the first `make gmail-auth`
GMAIL_TOKEN_JSON=secrets/gmail_token.json
# The dedicated outreach mailbox (never your main inbox)
GMAIL_SENDER=Charles@titanrealtyinvestments.com
# Where the 7am report is emailed
REPORT_TO=rodrigo@titanrealtyinvestments.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
# Public base URL for the Twilio inbound webhook (ngrok or VPS), e.g. https://abc.ngrok.app
WEBHOOK_PUBLIC_URL=
# Vercel Blob token for the dashboard (Vercel project → Storage → Blob → .env.local tab). Blank = dashboard off.
BLOB_READ_WRITE_TOKEN=
# Claude Code plan login for scheduled runs: run `claude setup-token` on the Mac and paste the token here (never in chat)
CLAUDE_CODE_OAUTH_TOKEN=
# Asana personal access token (Asana → My settings → Apps → Developer apps → Create token). Paste it here, never in chat.
ASANA_TOKEN=
